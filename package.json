{
  "name": "mcbanners-website",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "build:ssr": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:cloudflare": "pnpm run generate && pnpm dlx wrangler pages dev .output/public",
    "deploy:cloudflare": "pnpm run generate && pnpm dlx wrangler pages deploy .output/public",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "ci": "pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.114",
    "@iconify-json/simple-icons": "^1.2.86",
    "@nuxt/eslint": "^1.16.0",
    "@nuxt/test-utils": "^4.0.0",
    "@vue/language-core": "^3.3.4",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.4.1",
    "happy-dom": "^20.0.11",
    "nuxt": "^4.4.8",
    "prettier": "3.8.4",
    "typescript": "^6.0.3",
    "vitest": "^4.0.0",
    "vue-tsc": "^3.3.4"
  },
  "dependencies": {
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.7.1",
    "@pinia/nuxt": "^0.11.3",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0"
  },
  "packageManager": "pnpm@11.1.1"
}
