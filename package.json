{
  "name": "mcbanners-website",
  "private": true,
  "scripts": {
    "dev": "nuxt dev",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "build": "nuxt generate",
    "build:ssr": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:cloudflare": "pnpm run generate && pnpm dlx wrangler pages dev .output/public",
    "deploy:cloudflare": "pnpm run generate && pnpm dlx wrangler pages deploy .output/public",
    "postinstall": "nuxt prepare",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:trace": "playwright test --trace on",
    "test:e2e:report": "playwright show-report"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.111",
    "@iconify-json/simple-icons": "^1.2.82",
    "@nuxt/eslint": "^1.15.2",
    "@playwright/test": "^1.60.0",
    "@vue/language-core": "^3.2.9",
    "eslint": "^10.4.0",
    "nuxt": "^4.4.5",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.2.9"
  },
  "dependencies": {
    "@nuxt/image": "2.0.0",
    "@nuxt/ui": "^4.7.1",
    "@pinia/nuxt": "^0.11.3",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.3.0"
  },
  "packageManager": "pnpm@11.1.1"
}
