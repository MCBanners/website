{
  "name": "mcbanners-website",
  "private": true,
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "build:ssr": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "preview:cloudflare": "pnpm run generate && pnpm dlx wrangler pages dev .output/public",
    "deploy:cloudflare": "pnpm run generate && pnpm dlx wrangler pages deploy .output/public",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project unit",
    "test:nuxt": "vitest run --project nuxt",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "ci": "pnpm run check && pnpm run build"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/lucide": "^1.2.142",
    "@iconify-json/simple-icons": "^1.2.99",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.3",
    "@vue/language-core": "^3.3.12",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "happy-dom": "^20.14.6",
    "nuxt": "^4.6.1",
    "prettier": "3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "@pinia/nuxt": "^1.0.2",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3"
  },
  "packageManager": "pnpm@11.28.5",
  "type": "module"
}
